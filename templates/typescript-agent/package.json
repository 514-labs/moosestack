{
  "name": "typescript-agent",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "turbo run build --filter=web-app",
    "build:service": "pnpm --filter moosestack-service build",
    "dev": "pnpm --parallel --stream -r dev",
    "dev:moose": "pnpm --filter moosestack-service dev",
    "dev:web": "pnpm --filter web-app dev",
    "seed": "pnpm --filter moosestack-service seed",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "pnpm lint:biome && pnpm --filter web-app lint",
    "lint:biome": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "typescript": "^5.9.3",
    "turbo": "^2.6.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "@confluentinc/kafka-javascript",
      "@514labs/kafka-javascript"
    ],
    "overrides": {
      "tar": "7.5.7"
    }
  }
}
