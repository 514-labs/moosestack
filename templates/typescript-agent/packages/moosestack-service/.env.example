# Moose service uses JWT auth by default.
# Update moose.config.toml when switching from the built-in local issuer
# to your production OIDC provider.
#
# Optional ClickHouse overrides for connecting to an existing instance:
# - Prefer MOOSE_CLICKHOUSE_CONFIG__URL when you already have a connection string.
# - Use the individual fields below when your provider gives you separate values.
#
# MOOSE_CLICKHOUSE_CONFIG__URL=
# MOOSE_CLICKHOUSE_CONFIG__DB_NAME=
# MOOSE_CLICKHOUSE_CONFIG__HOST=
# MOOSE_CLICKHOUSE_CONFIG__HOST_PORT=
# MOOSE_CLICKHOUSE_CONFIG__USER=
# MOOSE_CLICKHOUSE_CONFIG__PASSWORD=
# MOOSE_CLICKHOUSE_CONFIG__USE_SSL=
# MOOSE_CLICKHOUSE_CONFIG__NATIVE_PORT=
