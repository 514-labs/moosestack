LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MOOSE_AUTH_MODE=local
MOOSE_SERVICE_URL=http://localhost:4000
OIDC_CLIENT_ID=
