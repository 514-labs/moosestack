AUTH_SECRET=replace-me-with-a-random-secret
MOOSE_AUTH_MODE=local
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-haiku-4-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# Amazon Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Production OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_CLAIM=tenant_id

# Base Moose service URL used for dashboard APIs and, by default,
# the custom MCP tools endpoint.
MOOSE_SERVICE_URL=http://localhost:4000

# Optional override for the custom MCP tools endpoint.
# Leave unset unless the tools endpoint lives on a different URL.
# MCP_SERVER_URL=http://localhost:4000/tools
