AUTH_SECRET=replace-me-with-a-random-secret
AWS_ACCESS_KEY_ID=
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_GUARDRAIL_ID=
