# ClickHouse connection for preview benchmarking.
# Fill in credentials for your 514 deployment or self-hosted ClickHouse.
# Benchmark thresholds and sample counts live in benchmark.config.ts.
MOOSE_CLICKHOUSE_CONFIG__HOST=
MOOSE_CLICKHOUSE_CONFIG__HOST_PORT=8443
MOOSE_CLICKHOUSE_CONFIG__USER=default
MOOSE_CLICKHOUSE_CONFIG__PASSWORD=
MOOSE_CLICKHOUSE_CONFIG__DB_NAME=
MOOSE_CLICKHOUSE_CONFIG__USE_SSL=true