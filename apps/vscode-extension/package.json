{
  "name": "fiveonefour",
  "displayName": "Fiveonefour for MooseStack",
  "description": "Onboard MooseStack projects with workspace setup, CLI bootstrap, and dev harness configuration for VS Code-family editors.",
  "version": "0.0.0",
  "publisher": "514-labs",
  "homepage": "https://docs.fiveonefour.com/moosestack",
  "bugs": {
    "url": "https://github.com/514-labs/moosestack/issues"
  },
  "qna": "http://slack.moosestack.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/514-labs/moosestack",
    "directory": "apps/vscode-extension"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Extension Packs"
  ],
  "keywords": [
    "moosestack",
    "moose",
    "fiveonefour",
    "vscode",
    "cursor",
    "kiro",
    "mcp",
    "onboarding",
    "clickhouse",
    "developer-tools"
  ],
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "pricing": "Free",
  "icon": "icon.png",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Fiveonefour can discover Moose projects and show setup status in Restricted Mode. Project scaffolding, workspace configuration, CLI installation, and dev harness setup require a trusted workspace."
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:moose.config.toml",
    "onCommand:moosestack.createNewProject",
    "onCommand:moosestack.selectActiveProject",
    "onCommand:moosestack.configureWorkspace",
    "onCommand:moosestack.setupHarness",
    "onCommand:moosestack.showSetupStatus"
  ],
  "main": "./dist/extension.js",
  "extensionPack": [
    "514-labs.moosestack-lsp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moosestack.createNewProject",
        "enablement": "isWorkspaceTrusted",
        "title": "Fiveonefour: Create Moose Project"
      },
      {
        "command": "moosestack.selectActiveProject",
        "title": "Fiveonefour: Select Active Moose Project"
      },
      {
        "command": "moosestack.configureWorkspace",
        "enablement": "isWorkspaceTrusted",
        "title": "Fiveonefour: Configure Workspace"
      },
      {
        "command": "moosestack.setupHarness",
        "enablement": "isWorkspaceTrusted",
        "title": "Fiveonefour: Re-run Dev Harness Setup"
      },
      {
        "command": "moosestack.showSetupStatus",
        "title": "Fiveonefour: Show Setup Status"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src test",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "package:vsix": "pnpm run build && npx @vscode/vsce package",
    "publish:vscode": "pnpm run build && npx @vscode/vsce publish",
    "publish:openvsx": "pnpm run build && npx ovsx publish"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@repo/ts-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/vscode": "^1.90.0",
    "eslint": "catalog:",
    "typescript-eslint": "8.55.0",
    "typescript": "catalog:"
  }
}
